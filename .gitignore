# ============================================================================
# ANTARES Repository .gitignore
# ============================================================================

# ============================================================================
# Local Development (AI-generated helpers, notes, drafts)
# ============================================================================
.local/

# ============================================================================
# Secrets and Credentials (CRITICAL - DO NOT COMMIT)
# ============================================================================
.env
.env.local
.env.*.local
*.env
!template.env
!config.example.toml

# Certificates and keys
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_rsa.pub

# Credentials
credentials.json
secrets.yaml
secrets.toml
config.local.*
*.secret

# ============================================================================
# Operating Systems
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================================
# IDEs and Editors
# ============================================================================
# JetBrains (IntelliJ, CLion, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# VS Code
.vscode/
*.code-workspace
.history/

# Vim
*.swp
*.swo
*~
.*.sw?

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================================
# Logs and Databases
# ============================================================================
*.log
logs/
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ============================================================================
# Temporary and Cache Files
# ============================================================================
tmp/
temp/
*.tmp
*.bak
*.swp
*.cache

# ============================================================================
# Build artifacts and dependencies (handled by component-specific .gitignore)
# ============================================================================
# Note: Rust target/, Python venv/, and Node node_modules/ are handled
# by component-specific .gitignore files in subdirectories
